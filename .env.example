# Generate independent random values; never commit a populated .env file.
CHART_BRIDGE_API_KEY=
# Exactly 64 hexadecimal characters (32 random bytes). Preserve across restarts.
CHART_INSTITUTION_SECRET=
# At least 32 characters and the Midnight SDK password-strength requirements.
CHART_PRIVATE_STATE_PASSWORD=
CHART_SYNTHETIC_ONLY=true
CHART_BRIDGE_URL=http://127.0.0.1:4000
CHART_ALLOW_RAW_BUNDLE_EXPORT=false

# Optional public-metadata-only transaction stage observations.
CHART_DIAGNOSTICS=false

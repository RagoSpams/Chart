# Dependencies
node_modules/
npm-debug.log*

# Build output
dist/
build/
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.*.local

# Compact contract build artifacts (regenerated by `compact compile`)
contracts/managed/

# Midnight network state (per-network seeds, deploy addresses) — sensitive
.midnight-state.json

# Midnight wallet sync state (per-network serialized wallet cache) — sensitive
.midnight-wallet-state/

# Local LevelDB private-state store (bridge/verifier-server persist here) —
# real binary wallet/private-state data, not source
midnight-level-db/

# Claude Code's own local session/tool state — not part of the project
.claude/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# Logs
logs/
*.log

# Coverage
coverage/

# Private/local state
*-state/
tmp/
temp/

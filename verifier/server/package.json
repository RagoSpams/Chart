{
  "name": "@gnuhealth-midnight/verifier-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone verifier-side server \u2014 completely separate process from bridge/, with its own recipient identity. Wraps the real Midnight SDK to let an outside regulator/researcher check a disclosure token against the real deployed gnuhealth_disclosure contract, without any dependency on GNU Health or the institution's own bridge service.",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "clean": "node ../../scripts/clean.mjs server"
  },
  "dependencies": {
    "@gnuhealth-midnight/contracts": "0.1.0",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "rxjs": "^7.8.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.3",
    "tsx": "^4.23.12"
  }
}
